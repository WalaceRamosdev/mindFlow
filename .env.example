# ==========================================
# MINDFLOW CONFIGURAÇÃO DE AMBIENTE (EXPO)
# ==========================================
# Renomeie este arquivo para .env e preencha as chaves abaixo para habilitar conexões reais.

# 1. CONEXÃO COM O BACKEND (SUPABASE)
# Obtenha na aba Settings -> API do seu dashboard do Supabase.
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-jwt-aqui

# 2. INTEGRAÇÃO DE PAGAMENTOS (STRIPE / MERCADO PAGO)
# Chaves públicas de teste para sandbox ou produção.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_suachavepublicastripeaqui
EXPO_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=APP_USR-suachavepublicamercadopagoaqui

# 3. VIDEOCHAMADA (AGORA AUDIO/VIDEO WEB_RTC)
# Token e App ID gerados no console do Agora.io para canais de telemedicina.
EXPO_PUBLIC_AGORA_APP_ID=seu-agora-app-id-aqui

# 4. CONFIGURAÇÃO DE SEGURANÇA E AMBIENTE
# 'development' ou 'production'
EXPO_PUBLIC_ENVIRONMENT=development
